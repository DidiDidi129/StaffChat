{
	"schemaVersion": 1,
	"id": "staffchat",
	"version": "${version}",
	"name": "StaffChat",
	"description": "A Fabric mod that adds a staff chat feature with LuckPerms integration and Discord webhook support. Includes commands /staffchat and /sc for restricted staff communication.",
	"authors": [
		"Your Name"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/yourusername/staffchat"
	},
	"license": "CC0-1.0",
	"icon": "assets/staffchat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.staffchat.Staffchat"
		],
		"client": [
			"com.staffchat.StaffchatClient"
		]
	},
	"mixins": [
		"staffchat.mixins.json",
		{
			"config": "staffchat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"luckperms": "*"
	},
	"suggests": {
		"discord-webhooks": "*"
	}
}